# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Obsidian (作業状態ファイルは頻繁に変わるので除外)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 業務データは別のプライベートリポジトリで管理（このリポジトリは公開のため除外）
company/

# 業務内容を含むコマンドは公開リポジトリに入れない（正は company/.claude/commands/）
.claude/commands/my-note.md

# 議事録テンプレートのビルド成果物（プロファイルから再生成できる）
templates/built/

# npm install docx で作られる（テンプレート生成のときだけ必要）
node_modules/
